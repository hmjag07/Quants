# Copy this file to .env and fill in your own values. NEVER commit .env (it is in .gitignore).
# Anything left out uses the default in config.py. Comments go on their own lines.

# --- broker: alpaca (paper trading) | paper (offline, for backtest.py only) ---
BROKER=alpaca
# Your Alpaca PAPER account keys (alpaca.markets -> Paper Trading -> API Keys)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex = the free data feed
ALPACA_FEED=iex

# --- what to trade ---
INSTRUMENT=SPY
# bar size: M1 M5 M15 M30 H1
GRANULARITY=H1

# --- strategy ---
FAST=20
SLOW=50
MOM_LOOKBACK=10
ATR_PERIOD=14

# --- risk ---
# fraction of equity risked per trade (0.005 = 0.5%; more than 0.05 is refused)
RISK_PCT=0.005
# stop = ATR_STOP_MULT x ATR from entry; target = TP_RR x the stop distance
ATR_STOP_MULT=2.0
TP_RR=2.0
# 1.0 = no leverage
MAX_LEVERAGE=1.0
# halt for the rest of the day after this fractional drop from the day's start
MAX_DAILY_LOSS=0.02
MAX_CONSECUTIVE_ERRORS=5
